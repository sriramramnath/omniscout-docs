{
  "version": "2.17",
  "children": [
    {
      "type": "frame",
      "id": "docsRoot",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 1600,
      "fill": "#ffffff",
      "children": [
        {
          "type": "text",
          "id": "galleryTitle",
          "x": 64,
          "y": 40,
          "width": 1152,
          "fill": "#000000ff",
          "content": "OmniScout Docs — What's inside",
          "fontFamily": "Sora",
          "fontSize": 48,
          "fontWeight": "700",
          "letterSpacing": -1.28,
          "lineHeight": 1.1
        },
        {
          "type": "text",
          "id": "gallerySubtitle",
          "x": 64,
          "y": 110,
          "width": 1152,
          "fill": "#0000008c",
          "content": "Everything you need to use OmniScout — copy-pasted from the site.",
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": 500,
          "letterSpacing": -0.1,
          "lineHeight": 1.45
        },
        {
          "type": "frame",
          "id": "galleryGrid",
          "x": 64,
          "y": 180,
          "width": 1152,
          "layout": "grid",
          "columns": 3,
          "gap": 24,
          "children": [
            { "type": "frame", "id": "tileSearch", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgSearch", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-search.png", "mode": "fill" } },
              { "type": "text", "id": "labelSearch", "fill": "#000000ff", "content": "Search — /en/cli/overview", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverSearch", "fill": "#0000008c", "content": "Semantic web search, answers, and extraction.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileBrowser", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgBrowser", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-browser.png", "mode": "fill" } },
              { "type": "text", "id": "labelBrowser", "fill": "#000000ff", "content": "Browser — /en/cli/commands", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverBrowser", "fill": "#0000008c", "content": "Playwright automation: navigate, click, snapshot, screenshot.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileAgents", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgAgents", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-agents.png", "mode": "fill" } },
              { "type": "text", "id": "labelAgents", "fill": "#000000ff", "content": "Agents — /en/cli/agents", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverAgents", "fill": "#0000008c", "content": "Drop-in prompts for Claude Code, Cursor, Codex.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileComputer", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgComputer", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-computer.png", "mode": "fill" } },
              { "type": "text", "id": "labelComputer", "fill": "#000000ff", "content": "Computer — /en/cli/computer", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverComputer", "fill": "#0000008c", "content": "Desktop automation for macOS: type, key, screenshot, clipboard.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileCloud", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgCloud", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-cloud.png", "mode": "fill" } },
              { "type": "text", "id": "labelCloud", "fill": "#000000ff", "content": "Cloud API — /en/api", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverCloud", "fill": "#0000008c", "content": "Hosted search, answers, browser/computer sessions and files.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileBilling", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgBilling", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-billing.png", "mode": "fill" } },
              { "type": "text", "id": "labelBilling", "fill": "#000000ff", "content": "Billing — /en/api/billing", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverBilling", "fill": "#0000008c", "content": "Usage-based pricing (30% markup), spending caps, Stripe meters.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]},
            { "type": "frame", "id": "tileLogin", "width": 352, "height": 420, "fill": "#f5f5f5", "cornerRadius": 16, "layout": "vertical", "gap": 12, "padding": [12,12,12,12], "children": [
              { "type": "frame", "id": "imgLogin", "width": 328, "height": 260, "cornerRadius": 12, "fill": { "type": "image", "enabled": true, "url": "/img/gallery-login.png", "mode": "fill" } },
              { "type": "text", "id": "labelLogin", "fill": "#000000ff", "content": "Login / Sessions — /en/cli/overview", "fontFamily": "Inter", "fontSize": 14, "fontWeight": 500, "letterSpacing": -0.08 },
              { "type": "text", "id": "hoverLogin", "fill": "#0000008c", "content": "Daemon sessions, profiles, persistent cookies, session secrets.", "fontFamily": "Inter", "fontSize": 12, "lineHeight": 1.4 }
            ]}
          ]
        }
      ]
    }
  ]
}
